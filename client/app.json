{
  "expo": {
    "name": "Raspberry Pi",
    "slug": "raspberry-pi-monitor",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "pimon",
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID confirms it's you before opening a shell, the desktop, or running a destructive action."
        }
      ],
      "expo-secure-store",
      "@bacons/apple-targets"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abo5.raspberryapp",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Connect to the Agent running on your Raspberry Pi on your local network."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.abo5.raspberryapp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
